+
+/* The table: one card per seat, wrapping to a single column on a phone. */
+.wwyhd-table { margin: 1.25rem 0; }
+.wwyhd-seats {
+  list-style: none; margin: 0; padding: 0;
+  display: grid; gap: .75rem; grid-template-columns: 1fr;
+}
+@media (min-width: 640px) { .wwyhd-seats { grid-template-columns: 1fr 1fr; } }
+.wwyhd-seat {
+  background: var(--paper); border: 1px solid var(--line);
