+const storedRows = (db: Database): ResultRow[] =>
+  db.query("SELECT * FROM wwyhd_results ORDER BY rowid").all() as ResultRow[];
+
+// --- leg (a) ---------------------------------------------------------------
+
+describe("(a) POST records one row per attempt and scores it itself [M1]", () => {
